{
  "name": "MiniMarketTycoon",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Remotes": {
        "$path": "src/ReplicatedStorage/Remotes"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "MiniMarket": {
        "$path": "src/ServerScriptService"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Assets": {
        "$path": "src/ServerStorage/Assets"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "MiniMarketClient": {
          "$path": "src/StarterPlayer/StarterPlayerScripts"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "MainUI": {
        "$path": "src/StarterGui/MainUI"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      },
      "Map": {
        "$path": "src/Workspace/Map"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.4, 0.45, 0.5],
        "Brightness": 2,
        "ClockTime": 14,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.5, 0.55, 0.6],
        "Technology": "ShadowMap"
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
